#!/bin/bash
set -euo pipefail

# Proxmox Hardware Sensors Agent
# Initial universal detector

SENSORS_JSON="$(sensors -j 2>/dev/null || echo '{}')"

python3 - "$SENSORS_JSON" <<'PY'
import json
import sys
import glob
import os

try:
    data = json.loads(sys.argv[1])
except Exception:
    data = {}

def is_number(value):
    return isinstance(value, (int, float)) and value == value

def find_temp(sensor_names):
    """
    Find the first useful temperature from a preferred list
    of sensor/chip names.
    """
    for chip_name, chip in data.items():
        if not isinstance(chip, dict):
            continue

        chip_lower = chip_name.lower()

        if not any(name in chip_lower for name in sensor_names):
            continue

        for label, values in chip.items():
            if not isinstance(values, dict):
                continue

            value = values.get("temp1_input")

            if is_number(value):
                result = {
                    "value": value,
                    "sensor": label,
                }

                if is_number(values.get("temp1_max")):
                    result["high"] = values["temp1_max"]

                if is_number(values.get("temp1_crit")):
                    result["critical"] = values["temp1_crit"]

                return result

    return None

def find_cpu_temperature():
    # Intel
    for chip_name, chip in data.items():
        if "coretemp" not in chip_name.lower():
            continue

        for label, values in chip.items():
            if not isinstance(values, dict):
                continue

            if label.lower().startswith("package"):
                value = values.get("temp1_input")
                if is_number(value):
                    result = {
                        "value": value,
                        "sensor": label,
                    }

                    if is_number(values.get("temp1_max")):
                        result["high"] = values["temp1_max"]

                    if is_number(values.get("temp1_crit")):
                        result["critical"] = values["temp1_crit"]

                    return result

    # AMD
    for chip_name, chip in data.items():
        chip_lower = chip_name.lower()

        if not any(x in chip_lower for x in ("k10temp", "zenpower")):
            continue

        preferred = []

        for label, values in chip.items():
            if not isinstance(values, dict):
                continue

            label_lower = label.lower()

            if label_lower in ("tctl", "tdie"):
                preferred.append((0, label, values))
            else:
                preferred.append((1, label, values))

        for _, label, values in sorted(preferred):
            value = values.get("temp1_input")

            if is_number(value):
                result = {
                    "value": value,
                    "sensor": label,
                }

                if is_number(values.get("temp1_max")):
                    result["high"] = values["temp1_max"]

                if is_number(values.get("temp1_crit")):
                    result["critical"] = values["temp1_crit"]

                return result

    return find_temp(("coretemp", "k10temp", "zenpower"))

def find_nvme_temperatures():
    result = []

    for chip_name, chip in data.items():
        chip_lower = chip_name.lower()

        if "nvme" not in chip_lower:
            continue

        for label, values in chip.items():
            if not isinstance(values, dict):
                continue

            value = values.get("temp1_input")

            if not is_number(value):
                continue

            entry = {
                "type": "nvme",
                "name": "NVMe",
                "temperature": {
                    "value": value,
                    "sensor": label,
                },
            }

            if is_number(values.get("temp1_max")):
                entry["temperature"]["high"] = values["temp1_max"]

            if is_number(values.get("temp1_crit")):
                entry["temperature"]["critical"] = values["temp1_crit"]

            result.append(entry)

    return result

def find_gpu_temperature():
    for chip_name, chip in data.items():
        chip_lower = chip_name.lower()

        if not any(x in chip_lower for x in ("amdgpu", "radeon", "nouveau")):
            continue

        for label, values in chip.items():
            if not isinstance(values, dict):
                continue

            for key, value in values.items():
                if key.endswith("_input") and "temp" in key and is_number(value):
                    result = {
                        "value": value,
                        "sensor": label,
                    }

                    max_value = values.get(key.replace("_input", "_max"))
                    crit_value = values.get(key.replace("_input", "_crit"))

                    if is_number(max_value):
                        result["high"] = max_value

                    if is_number(crit_value):
                        result["critical"] = crit_value

                    return result

    return None

def cpu_frequency():
    paths = glob.glob(
        "/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq"
    )

    values = []

    for path in paths:
        try:
            with open(path) as f:
                values.append(int(f.read().strip()))
        except Exception:
            pass

    if not values:
        return None

    # Average frequency of all available CPUs, converted kHz -> GHz.
    return round(sum(values) / len(values) / 1000000, 3)

def cpu_load():
    try:
        with open("/proc/loadavg") as f:
            return float(f.read().split()[0])
    except Exception:
        return None

cpu = {}

temperature = find_cpu_temperature()
if temperature:
    cpu["temperature"] = temperature

frequency = cpu_frequency()
if frequency is not None:
    cpu["frequency"] = frequency

load = cpu_load()
if load is not None:
    cpu["load"] = load

output = {
    "version": 1,
    "cpu": cpu,
    "gpu": [],
    "storage": find_nvme_temperatures(),
}

gpu = find_gpu_temperature()
if gpu:
    output["gpu"].append({
        "type": "gpu",
        "temperature": gpu,
    })

print(json.dumps(output, indent=2))
PY
