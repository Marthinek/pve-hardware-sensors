#!/bin/bash
set -euo pipefail

# Proxmox Hardware Sensors Agent
# Universal hardware sensor detection

SENSORS_JSON="$(sensors -j 2>/dev/null || echo '{}')"

python3 - "$SENSORS_JSON" <<'PY'
import json
import sys
import glob

try:
    data = json.loads(sys.argv[1])
except Exception:
    data = {}

def is_number(value):
    return isinstance(value, (int, float)) and value == value

def temp_result(chip_name, sensor_name, values, input_key):
    value = values.get(input_key)

    if not is_number(value):
        return None

    result = {
        "value": value,
        "sensor": sensor_name,
        "chip": chip_name,
    }

    suffix = input_key[:-6]  # remove "_input"

    max_value = values.get(suffix + "_max")
    crit_value = values.get(suffix + "_crit")

    if is_number(max_value):
        result["high"] = max_value

    if is_number(crit_value):
        result["critical"] = crit_value

    return result

def find_cpu_temperature():
    # Intel coretemp
    for chip_name, chip in data.items():
        if "coretemp" not in chip_name.lower():
            continue

        for sensor_name, values in chip.items():
            if not isinstance(values, dict):
                continue

            if sensor_name.lower().startswith("package"):
                result = temp_result(
                    chip_name,
                    sensor_name,
                    values,
                    "temp1_input"
                )

                if result:
                    return result

    # AMD k10temp / zenpower
    for chip_name, chip in data.items():
        chip_lower = chip_name.lower()

        if not any(x in chip_lower for x in ("k10temp", "zenpower")):
            continue

        candidates = []

        for sensor_name, values in chip.items():
            if not isinstance(values, dict):
                continue

            priority = 10

            if sensor_name.lower() == "tctl":
                priority = 0
            elif sensor_name.lower() == "tdie":
                priority = 1

            candidates.append((priority, sensor_name, values))

        for _, sensor_name, values in sorted(candidates):
            result = temp_result(
                chip_name,
                sensor_name,
                values,
                "temp1_input"
            )

            if result:
                return result

    return None

def find_gpu_temperature():
    gpu_names = (
        "amdgpu",
        "radeon",
        "nouveau",
        "i915",
        "xe",
    )

    for chip_name, chip in data.items():
        chip_lower = chip_name.lower()

        if not any(name in chip_lower for name in gpu_names):
            continue

        for sensor_name, values in chip.items():
            if not isinstance(values, dict):
                continue

            for key in values:
                if not key.startswith("temp") or not key.endswith("_input"):
                    continue

                result = temp_result(
                    chip_name,
                    sensor_name,
                    values,
                    key
                )

                if result:
                    return result

    return None

def find_storage_temperatures():
    result = []

    storage_names = (
        "nvme",
        "drivetemp",
        "ata",
        "smart",
        "hdd",
        "ssd",
    )

    for chip_name, chip in data.items():
        chip_lower = chip_name.lower()

        if not any(name in chip_lower for name in storage_names):
            continue

        for sensor_name, values in chip.items():
            if not isinstance(values, dict):
                continue

            for key in values:
                if not key.startswith("temp") or not key.endswith("_input"):
                    continue

                temperature = temp_result(
                    chip_name,
                    sensor_name,
                    values,
                    key
                )

                if not temperature:
                    continue

                result.append({
                    "type": "storage",
                    "name": sensor_name,
                    "temperature": temperature,
                })

    return result

def cpu_frequency():
    paths = glob.glob(
        "/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq"
    )

    values = []

    for path in paths:
        try:
            with open(path) as f:
                values.append(int(f.read().strip()))
        except Exception:
            pass

    if not values:
        return None

    return round(sum(values) / len(values) / 1000000, 3)

def cpu_load():
    try:
        with open("/proc/loadavg") as f:
            return float(f.read().split()[0])
    except Exception:
        return None

cpu = {}

temperature = find_cpu_temperature()
if temperature:
    cpu["temperature"] = temperature

frequency = cpu_frequency()
if frequency is not None:
    cpu["frequency"] = frequency

load = cpu_load()
if load is not None:
    cpu["load"] = load

output = {
    "version": 1,
    "cpu": cpu,
    "gpu": [],
    "storage": find_storage_temperatures(),
}

gpu = find_gpu_temperature()

if gpu:
    output["gpu"].append({
        "type": "gpu",
        "temperature": gpu,
    })

print(json.dumps(output, indent=2))
PY
